# =================================================================
#                 .env.example for deepdiver
# -----------------------------------------------------------------
# 这是一个示例文件。请将此文件复制为 '.env'，然后填入你的实际配置值。
# =================================================================
# Model routing mode: only these two endpoint/name pairs are required.
MODEL_ROUTING_SWITCH=true
SMALL_MODEL_URL=http://127.0.0.1:8103/v1
SMALL_MODEL_NAME=pangu_small
LARGE_MODEL_URL=http://127.0.0.1:8104/v1
LARGE_MODEL_NAME=pangu_large
# Optional for OpenAI-compatible services; local vLLM can use EMPTY.
SMALL_MODEL_API_KEY=EMPTY
LARGE_MODEL_API_KEY=EMPTY

# Non-routing mode only (set MODEL_ROUTING_SWITCH=false).
# OPENAI_BASE_URL=http://127.0.0.1:8103/v1
# OPENAI_API_KEY=EMPTY
# EXAMPLE_MODEL_NAME=pangu_small

# API setting
URL_CRAWLER_API_KEYS

SEARCH_URL
SEARCH_API_KEY

ENABLE_MEMORY
ENABLE_SHARED_MEMORY
MEMORY_BASE_URL

PROXY_CACHE
